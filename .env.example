# Copy this file to  .env.local  and fill in the values.
# NEVER put real values in this file, and never upload .env.local to GitHub.

# The long id in your Google Sheet web address:
#   https://docs.google.com/spreadsheets/d/THIS_PART/edit
GOOGLE_SHEET_ID=

# From the downloaded service account JSON file: "client_email"
GOOGLE_CLIENT_EMAIL=

# From the same JSON file: "private_key"  (keep the quotes and the \n marks)
GOOGLE_PRIVATE_KEY=

# Any long random text (at least 32 characters). Keeps logins safe.
SESSION_SECRET=
